
#include <stdio.h>

int main() {
    int a, b, c;
    printf("Enter three numbers: ");
    scanf("%d %d %d", &a, &b, &c);

    
    if (a >= b && a >= c) {
        printf("Largest number is: %d", a);
    } 
    else if (b >= a && b >= c) {
        printf("Largest number is: %d", b);
    } 
    else {
        printf("Largest number is: %d\n", c);
    }
    printf ("25331A05F9");
    return 0;
}
